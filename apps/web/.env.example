# Optional. Everything prefixed VITE_ is bundled into the browser and is PUBLIC.
# Never put a private RPC key with billing or write access here.
# Default: the public Arbitrum Sepolia endpoint https://sepolia-rollup.arbitrum.io/rpc
VITE_ARB_SEPOLIA_RPC_URL=

# Optional. WalletConnect (Reown) project ID from https://cloud.reown.com. Without it the wallet picker offers
# browser-extension wallets only; with it, mobile and QR-code wallets (MetaMask mobile, Rainbow, Trust, ...) appear.
# Public by design; restrict allowed domains in the Reown dashboard.
VITE_WALLETCONNECT_PROJECT_ID=
