# Copy to .env and fill in. NEVER commit .env.

# Deployer key. Prefer a Foundry keystore instead: `cast wallet import clinova-deployer --interactive`
# and pass `--account clinova-deployer` to forge script. Use a throwaway testnet-only key.
PRIVATE_KEY=

# Arbitrum Sepolia (chain id 421614). Public fallback: https://sepolia-rollup.arbitrum.io/rpc (rate-limited).
# Prefer a provider URL (Alchemy/Infura/QuickNode); keep any API key only here.
ARB_SEPOLIA_RPC_URL=

# Contract verification. Foundry uses the Etherscan V2 multichain API; an Etherscan API key covers Arbiscan.
ARBISCAN_API_KEY=

# Circle USDC on Arbitrum Sepolia (verified 2026-09-30: symbol USDC, 6 decimals):
# 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d  (source: developers.circle.com/stablecoins/usdc-contract-addresses)
USDC_ADDRESS=

# Deployment (script/Deploy.s.sol). ADMIN_ADDRESS must be a multisig in production.
ADMIN_ADDRESS=
# Optional overrides (defaults shown): ADMIN_DELAY=172800 MIN_STAKE=100000000 UNBONDING_PERIOD=604800
# MIN_PRICE=1000000 REVIEW_PERIOD=604800 DISPUTE_PERIOD=1209600
